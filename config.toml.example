[model]
# Provider type: "gemini", "vertex", "openai", "anthropic", "openrouter", "ollama" or "thaillm"
provider = "gemini"
# The specific model identifier
model_name = "gemini-2.5-flash"
# The environment variable name that holds the API key (see .env.example)
api_key_env = "GOOGLE_API_KEY"

# Vertex AI settings
# project_id = "{project_id_str}"
# location = "{location_str}"

# Optional settings for OpenAI-compatible providers
# base_url = "https://api.openai.com/v1"


# --- Custom command definitions ---

[commands]
# Custom command definitions
[commands."/wiki"]
template = "wiki_search: {args}"
help = "Search the project wiki"

[commands."/memo"]
template = "add_memory: {args}"
help = "Save information to memory"

[commands."/parallel"]
template = "Execute the following tasks in parallel using the most appropriate specialized agents: {args}"
help = "Run tasks in parallel"

[commands."/goal"]
template = "ralph_wiggum_loop: goal='{goal}', stop_condition='{stop}'"
help = "Set a goal with a stop condition (goal | stop)"

[commands."/schedule"]
template = "schedule_task: goal='{goal}', cron_expr='{cron}', id='{uuid}'"
help = "Schedule a repeating task (goal | cron)"

[commands."/recall"]
template = "recall_memory: {args}"
help = "Recall information from memory"

[commands."/learn"]
template = "Analyze the recent conversation history, successes, and corrections to extract reusable rules, guidelines, or specialized skills. Save these insights to memory using add_memory so they can be recalled for future tasks. Context/Details: {args}"
help = "Reflect on recent successes or corrections to capture reusable skills or rules"

[commands."/grill"]
template = "Conduct an interactive interview with the user to align on a plan. Ask clarifying questions one at a time, gather all requirements, design decisions, and user preferences, and then compile the aligned plan. Save the final compiled plan to the folder '~/.nami/plans/' (e.g. as a markdown file). Prompt: {args}"
help = "Interview me to align on a plan and save it to '~/.nami/plans/'"


[commands."/skill"]
template = "Activate and execute the skill: {args}"
help = "Invoke a specific skill by name"

[commands."/mcp"]
template = "Query the connected MCP servers with: {args}"
help = "Execute a query against connected MCP servers"

# --- Granular Service Configurations (Optional) ---
# If a section is missing, it falls back to the default [model] settings.

[specialists.coder]
# provider = "anthropic"
# model_name = "claude-3-5-sonnet-latest"
# api_key_env = "ANTHROPIC_API_KEY"

[specialists.researcher]
# model_name = "gemini-2.5-pro"

[specialists.writer]

[specialists.ralph]

[specialists.generalist]

# --- Custom Dynamic Specialists ---
# You can define custom specialist agents under [specialists.custom.<agent_name>].
# These agents are automatically registered at runtime and can be delegated tasks.
# Each custom agent must define `description` (used for routing) and `instruction`.
# `model_name`, `provider`, etc. are optional overrides.
#
# [specialists.custom.database_guru]
# description = "A specialist in database design, query optimization, and SQL performance tuning."
# instruction = "You are an expert database administrator. Provide high-quality SQL queries and structural design advice."
# # provider = "gemini"
# # model_name = "gemini-2.5-pro"

[specialists.custom.editorial_director]
description = "A specialist in structural editing, narrative story arc analysis, pacing evaluation, character development, and manuscript reviews."
instruction = "You are an expert Editorial Director. Your goal is to review manuscripts and stories for structural integrity, narrative pacing, character arcs, and thematic consistency. Provide highly professional, structured, and constructive editorial reports."
provider = "gemini"
model_name = "gemini-2.5-pro"

[specialists.custom.creative_writer]
description = "A creative writer and story ghostwriter specializing in composing high-fidelity chapter drafts, detailed scene outlines, and engaging character descriptions."
instruction = "You are an expert Creative Writer and Ghostwriter. Your goal is to draft rich, engaging stories, outline compelling plots, and build vibrant, multi-dimensional characters. Maintain high-quality prose, descriptive pacing, and a cohesive tone."
provider = "gemini"
model_name = "gemini-2.5-pro"

[specialists.custom.proofreader]
description = "A proofreader and copy-editor specializing in grammar audits, spelling corrections, style guide formatting, punctuation, and line-by-line copy-editing."
instruction = "You are a meticulous Proofreader and Copy-Editor. Your goal is to inspect texts line-by-line for grammatical correctness, spelling accuracy, perfect punctuation, and formatting alignment (such as Chicago Manual of Style or AP). Ensure clarity, flow, and absolute polish."
provider = "gemini"
model_name = "gemini-2.5-flash"

[specialists.custom.cover_designer]
description = "A specialist in visual book design, cover art concepts, layouts, dust-jacket spine spacing, and graphics placeholder generation."
instruction = "You are a world-class Book Cover Designer. Your goal is to conceptualize and craft visual themes for book covers, front-and-back jacket layouts, and spine formatting. Provide highly descriptive artwork concepts, formatting specifications, and asset directions."
provider = "gemini"
model_name = "gemini-2.5-flash"

[specialists.custom.publishing_marketer]
description = "A specialist in book marketing, back-cover blurbs, Amazon SEO keywords, target audience mapping, launch strategy, and press releases."
instruction = "You are a strategic Publishing Marketer. Your goal is to maximize the visibility and commercial success of books. Craft high-converting back-cover blurbs, map out niche Amazon SEO keywords, define target reader personas, and design comprehensive launch campaigns."
provider = "gemini"
model_name = "gemini-2.5-flash"


[image_generation]
# Image generation is optimized for Gemini providers.
provider = "gemini"
model_name = "models/gemini-2.5-flash-image-preview"
api_key_env = "GOOGLE_API_KEY"

[audio_generation]
# Audio/Speech generation is optimized for Gemini/OpenAI providers.
provider = "gemini"
model_name = "gemini-3.1-flash-lite-audio"
api_key_env = "GOOGLE_API_KEY"

[video_generation]
# Video generation is optimized for Gemini/OpenAI providers.
provider = "gemini"
model_name = "gemini-3.1-flash-lite-video"
api_key_env = "GOOGLE_API_KEY"

[reflection]
# Reflection service synthesizes memories in the background.
enabled = false
# model_name = "gemini-2.5-flash"

[embedding]
# Configuration for vector embeddings used in long-term memory.
# model_name = "text-embedding-004"

# --- Tools Configuration ---
# [tools.shell]
# # Whitelist of additional allowed system executables for the shell execution tool.
# # Note: Built-in safe commands (git, ls, cargo, grep, echo, etc.) are always enabled.
# # allowed_commands = ["make", "pytest", "python"]

# --- Context Compaction ---
# Controls how Nami manages context window size during long conversations.
# All fields are optional — missing values use sensible defaults.
# [compaction]
# Turns between post-invocation compactions (summarize every N agent turns).
# Default: auto (3-6 based on model window).
# compaction_interval = 4
# Number of recent events preserved verbatim after post-invocation compaction.
# Default: 2
# overlap_size = 2
# Percentage of the model's context window that triggers intra-compaction (0-100).
# Default: 70
# token_threshold_pct = 70
# Number of recent events preserved after intra-compaction. Default: 10
# overlap_event_count = 10
# Heuristic characters-per-token ratio used for token estimation. Default: 4
# chars_per_token = 4

# Optional separate model for running summarization (lighter/cheaper than the main model).
# If omitted, the main agent model is used for summarization.
# [compaction.summarizer]
# model_name = "gemini-2.5-flash"
# api_key_env = "GOOGLE_API_KEY"

# Optional model context window overrides (model_name pattern -> window_size in tokens).
# Nami auto-detects window sizes for known models; use this to override or add new ones.
# [compaction.model_context_windows]
# "gemini-2.5-flash" = 1000000
# "claude-3-5-sonnet" = 200000
# "my-custom-model" = 128000

